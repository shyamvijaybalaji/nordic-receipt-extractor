      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst u = response.usage || {};\nconst HAIKU_IN = 1.00, HAIKU_OUT = 5.00; // $ per 1M tokens\nconst inputTokens = u.input_tokens || 0;\nconst outputTokens = u.output_tokens || 0;\nconst cacheWrite = u.cache_creation_input_tokens || 0;\nconst cacheRead = u.cache_read_input_tokens || 0;\nconst cost =\n  (inputTokens / 1e6) * HAIKU_IN +\n  (cacheWrite / 1e6) * HAIKU_IN * 1.25 +\n  (cacheRead / 1e6) * HAIKU_IN * 0.1 +\n  (outputTokens / 1e6) * HAIKU_OUT;\n\nreturn [{ json: {\n  user_id: $('Fetch Document Row').first().json.user_id,\n  document_id: $('Prepare Haiku Request').first().json.document_id,\n  model: 'haiku',\n  tokens_in: inputTokens,\n  tokens_out: outputTokens,\n  cost_usd: Math.round(cost * 1e6) / 1e6,\n  latency_ms: Date.now() - $('Prepare Haiku Request').first().json.requestedAt\n} }];"
      }
