    {
      "id": "w8-validate",
      "name": "Validate Haiku Extraction",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        300
      ],
      "parameters": {
        "jsCode": "const documentId = $('Prepare Haiku Request').first().json.document_id;\nconst response = $input.first().json;\n\nlet extracted;\ntry {\n  const textBlock = response.content.find((b) => b.type === 'text');\n  let text = (textBlock?.text || '').trim();\n  text = text.replace(/^```(?:json)?\\s*/i, '').replace(/```\\s*$/, '');\n  extracted = JSON.parse(text);\n} catch (e) {\n  return [{ json: {\n    document_id: documentId, date: null, vendor: null, total: null, currency: null,\n    vat_amount: null, vat_rate: null, description: null, category: null,\n    confidence: null, model_used: 'haiku', needs_review: true,\n    validation_errors: ['could not parse model response as JSON']\n  } }];\n}\n\nconst errors = [];\nconst validRates = [0, 6, 10, 12, 14.5, 15, 25, 25.5];\n\nconst lowConfidence = extracted.confidence && Object.values(extracted.confidence).some((c) => typeof c === 'number' && c < 0.75);\nif (lowConfidence) errors.push('low model confidence on at least one field');\n\nif (extracted.vat_rate != null && !validRates.includes(Number(extracted.vat_rate))) {\n  errors.push('unrecognized vat_rate');\n}\nif (extracted.total != null && extracted.vat_amount != null && extracted.vat_rate != null) {\n  const rate = Number(extracted.vat_rate);\n  const total = Number(extracted.total);\n  const expectedVat = total * rate / (100 + rate);\n  if (Math.abs(expectedVat - Number(extracted.vat_amount)) > 0.02 * total + 0.05) {\n    errors.push('vat_amount inconsistent with total and vat_rate');\n  }\n}\nif (extracted.date != null) {\n  const d = new Date(extracted.date);\n  const now = new Date();\n  const tenYearsAgo = new Date();\n  tenYearsAgo.setFullYear(now.getFullYear() - 10);\n  if (isNaN(d.getTime()) || d > now || d < tenYearsAgo) errors.push('implausible date');\n}\nif (extracted.currency != null && !/^[A-Z]{3}$/.test(extracted.currency)) {\n  errors.push('invalid currency code');\n}\nif (extracted.total != null && Number(extracted.total) <= 0) {\n  errors.push('total must be positive');\n}\n\nreturn [{ json: {\n  document_id: documentId,\n  date: extracted.date ?? null,\n  vendor: extracted.vendor ?? null,\n  total: extracted.total ?? null,\n  currency: extracted.currency ?? null,\n  vat_amount: extracted.vat_amount ?? null,\n  vat_rate: extracted.vat_rate ?? null,\n  description: extracted.description ?? null,\n  category: extracted.category_suggestion ?? null,\n  confidence: extracted.confidence ?? null,\n  model_used: 'haiku',\n  needs_review: errors.length > 0,\n  validation_errors: errors\n} }];"
      }
    },
