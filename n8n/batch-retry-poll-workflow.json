    {
      "id": "bp9-parse-results",
      "name": "Parse Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        140
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const batchInfo = $input.first().json;\nconst raw = batchInfo.data || '';\nconst lines = raw.split('\\n').map((l) => l.trim()).filter(Boolean);\nconst pending = $('Collect Pending').first().json.documents;\n\nconst validRates = [0, 6, 10, 12, 14.5, 15, 25, 25.5];\n\nfunction validate(extracted) {\n  const errors = [];\n  const lowConfidence = extracted.confidence && Object.values(extracted.confidence).some((c) => typeof c === 'number' && c < 0.75);\n  if (lowConfidence) errors.push('low model confidence on at least one field');\n  if (extracted.vat_rate != null && !validRates.includes(Number(extracted.vat_rate))) errors.push('unrecognized vat_rate');\n  if (extracted.total != null && extracted.vat_amount != null && extracted.vat_rate != null) {\n    const rate = Number(extracted.vat_rate);\n    const total = Number(extracted.total);\n    const expectedVat = (total * rate) / (100 + rate);\n    if (Math.abs(expectedVat - Number(extracted.vat_amount)) > 0.02 * total + 0.05) errors.push('vat_amount inconsistent with total and vat_rate');\n  }\n  if (extracted.date != null) {\n    const d = new Date(extracted.date);\n    const now = new Date();\n    const tenYearsAgo = new Date();\n    tenYearsAgo.setFullYear(now.getFullYear() - 10);\n    if (isNaN(d.getTime()) || d > now || d < tenYearsAgo) errors.push('implausible date');\n  }\n  if (extracted.currency != null && !/^[A-Z]{3}$/.test(extracted.currency)) errors.push('invalid currency code');\n  if (extracted.total != null && Number(extracted.total) <= 0) errors.push('total must be positive');\n  return errors;\n}\n\nconst out = [];\nfor (const line of lines) {\n  let parsed;\n  try {\n    parsed = JSON.parse(line);\n  } catch (e) {\n    continue;\n  }\n  const documentId = parsed.custom_id;\n  const doc = pending.find((d) => d.id === documentId);\n  if (!doc) continue;\n\n  if (parsed.result.type === 'succeeded') {\n    let extracted;\n    let parseFailed = false;\n    try {\n      const textBlock = parsed.result.message.content.find((b) => b.type === 'text');\n      let text = (textBlock?.text || '').trim();\n      text = text.replace(/^```(?:json)?\\s*/i, '').replace(/```\\s*$/, '');\n      extracted = JSON.parse(text);\n    } catch (e) {\n      extracted = {};\n      parseFailed = true;\n    }\n    const errors = parseFailed ? ['could not parse model response as JSON'] : validate(extracted);\n    out.push({\n      json: {\n        document_id: documentId,\n        user_id: doc.user_id,\n        outcome: 'succeeded',\n        date: extracted.date ?? null,\n        vendor: extracted.vendor ?? null,\n        total: extracted.total ?? null,\n        currency: extracted.currency ?? null,\n        vat_amount: extracted.vat_amount ?? null,\n        vat_rate: extracted.vat_rate ?? null,\n        description: extracted.description ?? null,\n        category: extracted.category_suggestion ?? null,\n        confidence: extracted.confidence ?? null,\n        needs_review: errors.length > 0,\n        validation_errors: errors\n      }\n    });\n  } else {\n    const reason =\n      parsed.result.type === 'errored'\n        ? parsed.result.error?.error?.message || parsed.result.error?.message || 'unknown error'\n        : parsed.result.type;\n    out.push({ json: { document_id: documentId, user_id: doc.user_id, outcome: parsed.result.type, error_message: reason } });\n  }\n}\nreturn out;"
      }
    },
