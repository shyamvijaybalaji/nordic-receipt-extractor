      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [620, 300],
      "parameters": {
        "jsCode": "const userId = $('Parse Trigger').first().json.user_id;\nconst objects = $input.all().map((item) => item.json).filter((o) => o && o.name);\nconst paths = objects.map((o) => `${userId}/${o.name}`);\nreturn [{ json: { user_id: userId, paths } }];"
      }
    },
